{
  "schemaVersion": 1,
  "excludeFromUpdates": ["src/**", "README.md", ".github/workflows/**"],
  "symlinks": {
    "CLAUDE.md": "AGENTS.md"
  },
  "afterCreate": [
    "mise install",
    "mise exec -- apm install --frozen",
    "pnpm install",
    "pnpm canonical:install",
    "pnpm routes:generate",
    "pnpm canonical:generate"
  ],
  "afterUpdate": [
    "mise install",
    "mise exec -- apm install --frozen",
    "pnpm install",
    "pnpm canonical:install",
    "pnpm check"
  ]
}
