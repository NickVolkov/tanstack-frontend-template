{
  "schemaVersion": 1,
  "excludeFromUpdates": ["src/**", "README.md", ".github/workflows/**"],
  "symlinks": {
    "CLAUDE.md": "AGENTS.md"
  },
  "afterCreate": [
    "apm install",
    "pnpm install",
    "pnpm canonical:install",
    "pnpm routes:generate",
    "pnpm canonical:generate"
  ],
  "afterUpdate": ["apm install", "pnpm install", "pnpm canonical:install", "pnpm check"]
}
