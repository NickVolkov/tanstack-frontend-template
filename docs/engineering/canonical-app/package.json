{
  "name": "canonical-article-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "vite preview",
    "routes:generate": "tsr generate",
    "gen:api": "openapi-ts",
    "gen:mocks:spec": "node scripts/generate-mock-openapi-spec.mjs",
    "generate": "pnpm gen:api && pnpm gen:mocks:spec && pnpm routes:generate",
    "typecheck": "pnpm generate && tsc --noEmit --incremental false",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "test": "vitest run",
    "storybook": "storybook dev -p 6007",
    "build:storybook": "storybook build",
    "check:generated": "pnpm generate && git diff --exit-code -- src/shared/api/generated src/mocks/openapi.spec.json src/routeTree.gen.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:generated"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "5.2.8",
    "@fontsource-variable/source-sans-3": "5.2.8",
    "@hey-api/client-fetch": "0.13.1",
    "@mantine/core": "9.2.1",
    "@mantine/hooks": "9.2.1",
    "@tanstack/react-form": "1.33.0",
    "@tanstack/react-query": "5.100.10",
    "@tanstack/react-router": "1.170.8",
    "@tanstack/react-router-ssr-query": "1.167.0",
    "@tanstack/react-start": "1.168.10",
    "msw": "2.14.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@msw/source": "0.6.1",
    "@storybook/addon-a11y": "10.4.0",
    "@storybook/addon-docs": "10.4.0",
    "@storybook/react-vite": "10.4.0",
    "@tanstack/router-cli": "1.167.46",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.5",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/coverage-v8": "4.1.6",
    "eslint-plugin-fsd-lint": "1.2.1",
    "jsdom": "27.2.0",
    "nitro": "3.0.260522-beta",
    "openapi-types": "12.1.3",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "storybook": "10.4.0",
    "typescript": "6.0.2",
    "vite": "8.0.13",
    "vitest": "4.1.6",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
